{
  "name": "atmosfera",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "bun --hot apps/discord-bot/src/index.ts",
    "render": "bun scripts/render.ts",
    "smoke:resvg": "bun scripts/smoke/resvg.ts"
  },
  "dependencies": {
    "@atmosfera/charts": "workspace:*",
    "@atmosfera/climate": "workspace:*",
    "@atmosfera/config": "workspace:*",
    "@atmosfera/db": "workspace:*",
    "@atmosfera/geocode": "workspace:*",
    "@atmosfera/gemini": "workspace:*",
    "@atmosfera/city-roast": "workspace:*",
    "@atmosfera/user-roast": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.3.14",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/suncalc": "^1.9.2",
    "typescript": "^5.7.2"
  }
}
