# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Restrict slash command registration to one guild during dev (optional)
DISCORD_DEV_GUILD_ID=

# Database (SQLite path, relative to repo root)
DATABASE_URL=file:./data/atmosfera.db

# Open-Meteo requires no key. Nominatim fallback should set a contact email per their ToS.
NOMINATIM_USER_AGENT=

# Google AI Studio API key for /roast and tone/culture/length options on chart
# commands. Get one at https://aistudio.google.com — free tier is generous.
# Roast features no-op gracefully if this is unset.
GEMINI_API_KEY=

# Permissions
# Comma-separated Discord user IDs with bot-owner override on commands tagged
# with `ownerOverride` (currently /roast-setup, /roast-config). Owners can run
# those without server admin perms. Does NOT bypass `requiredClientPermissions`
# or `protected` commands.
DISCORD_OWNER_IDS=1371858385104011355
