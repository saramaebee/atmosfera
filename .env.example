# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Restrict slash command registration to one guild during dev (optional)
DISCORD_DEV_GUILD_ID=

# Database (SQLite path, relative to repo root)
DATABASE_URL=file:./data/atmosfera.db

# Open-Meteo requires no key. Nominatim fallback should set a contact email per their ToS.
NOMINATIM_USER_AGENT=

# Permissions
# Comma-separated Discord user IDs with bot-owner override on commands tagged
# with `ownerOverride` (none currently). Owners can run
# those without server admin perms. Does NOT bypass `requiredClientPermissions`
# or `protected` commands. Leave empty to disable the override path entirely.
# Also grants god-mode access in the web app (apps/web) — owners can switch
# into any guild the bot is in, and see the /admin stats page.
DISCORD_OWNER_IDS=

# Web app (apps/web). Only needed if you're running the moderation dashboard.
# The bot boots fine without these set.
#
# Create a Discord OAuth2 client at https://discord.com/developers/applications
# and add the callback URL below to its "Redirects" list. Use scopes
# `identify guilds`.
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# 32-byte secret used to sign session cookies and AES-GCM encrypt OAuth
# tokens at rest. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Port the web app binds to (default 3000) and the public-facing URL used
# when constructing absolute redirects / login links.
WEB_PORT=3000
WEB_PUBLIC_URL=http://localhost:3000

# Internal bot↔web HTTP API. The bot exposes live discord.js state (channels,
# bot permissions per channel) over loopback so the web app can render owner
# debug views. Bound to 127.0.0.1 only; the token is the sole auth — keep it
# secret and DO NOT expose this port publicly.
#
# Leave INTERNAL_API_TOKEN unset to disable: the bot won't start the server
# and the web app hides the owner debug pages.
#
# Generate with: openssl rand -hex 32
INTERNAL_API_PORT=4317
INTERNAL_API_TOKEN=
