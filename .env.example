# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Restrict slash command registration to one guild during dev (optional)
DISCORD_DEV_GUILD_ID=

# Database (SQLite path, relative to repo root)
DATABASE_URL=file:./data/atmosfera.db

# Open-Meteo requires no key. Nominatim fallback should set a contact email per their ToS.
NOMINATIM_USER_AGENT=
